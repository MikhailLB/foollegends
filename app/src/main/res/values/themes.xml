<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.FoolLegends" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
    </style>

    <style name="Theme.FoolLegends.Fullscreen" parent="Theme.FoolLegends">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="Theme.FoolLegends.Web" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/bg_red</item>
        <item name="colorPrimaryDark">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
    </style>

</resources>
